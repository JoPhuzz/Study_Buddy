# The only model provider. There is no search key here on purpose: this buddy answers
# from what you showed it, and no code in the repo can reach a search engine.
ANTHROPIC_API_KEY=

# Optional model overrides (no date suffixes).
#DEEP_MODEL=claude-sonnet-5
#FAST_MODEL=claude-haiku-4-5
# Reading a capture is the load-bearing call — its notes are the only record that
# survives. "deep" (default) is careful; "fast" is ~1/5 the cost on a long scroll.
#READ_TIER=deep

# A model of your own for the ANSWERING half. Any server that speaks the OpenAI-style
# chat-completions protocol: Ollama, LM Studio, llama.cpp, vLLM. URL and MODEL switch it
# on; KEY is whatever the server or its tunnel wants (leave empty if nothing does).
# Reading captures stays on the vision model above regardless — that is the call every
# answer inherits, and a text model cannot make it. Briefs stay there too unless
# LOCAL_BRIEFS=1 (compaction once per subject, on the good model, is cheap insurance).
#LOCAL_LLM_URL=https://your-tunnel.example.com      # base, /v1, or the full path all work
#LOCAL_LLM_KEY=
#LOCAL_LLM_MODEL=qwen3:14b
#LOCAL_BRIEFS=0

# The password that gates the whole app (empty = open, dev only).
ACCESS_PASSWORD=

# The brain — where briefs persist across Railway restarts.
# Needs a fine-grained PAT with Contents: Read AND Write on JoPhuzz/buddies-backups.
KNOWLEDGE_REPO=https://github.com/JoPhuzz/buddies-backups.git
KNOWLEDGE_TOKEN=
KNOWLEDGE_SUBPATH=study-web/latest.tar.gz
AUTO_PUSH_SECONDS=600
